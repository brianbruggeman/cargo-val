+fn trace_decimal(mut value: u64, output: &mut [u8], position: &mut usize) {
+    let mut digits = [0_u8; 20];
+    let mut count = 0;
+    loop {
+        digits[count] = b'0' + (value % 10) as u8;
+        count += 1;
+        value /= 10;
+        if value == 0 { break; }
+    }
+    while count != 0 {
+        count -= 1;
+        output[*position] = digits[count];
+        *position += 1;
+    }
+}
+
+fn trace_event(label: &[u8]) {
+    let mut now = libc::timespec { tv_sec: 0, tv_nsec: 0 };
+    if unsafe { libc::clock_gettime(libc::CLOCK_MONOTONIC, &mut now) } != 0 { return; }
+    let stamp = now.tv_sec as u64 * 1_000_000_000 + now.tv_nsec as u64;
+    let mut line = [0_u8; 96];
+    let mut offset = 0;
+    for fragment in [b"C54TRACE ".as_slice(), label, b" "] {
+        line[offset..offset + fragment.len()].copy_from_slice(fragment);
+        offset += fragment.len();
+    }
+    trace_decimal(stamp, &mut line, &mut offset);
+    line[offset..offset + 3].copy_from_slice(b" 0\n");
+    unsafe { libc::write(2, line.as_ptr().cast(), offset + 3); }
+}
 
