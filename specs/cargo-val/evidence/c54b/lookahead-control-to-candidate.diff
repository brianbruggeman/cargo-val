+    let argv = [
+        executable_cstr.as_ptr(),
+        c"--list".as_ptr(),
+        core::ptr::null(),
+    ];
+    let child = spawn_raw_unix(executable_cstr, &argv, envp, Some(cwd), false)
+        .map_err(|_| RunError::Spawn)?;
+    Ok(PendingListing {
+        child,
+        path,
+        path_length: executable.len(),
+    })
 }
 
